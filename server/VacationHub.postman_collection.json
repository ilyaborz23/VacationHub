{
  "info": {
    "name": "VacationHub API",
    "description": "All routes of the VacationHub server.\n\nBefore running: start the server, then set the collection variables adminEmail and adminPassword to an existing administrator. Add vacation uses images/rome.jpg, so either set the Postman working directory to the server folder or choose a file in the request body.\n\nRun the folders from top to bottom: requests save the tokens and ids that later requests use. Running the collection creates one new test user, because registration has no delete route. The test vacation is deleted by the last admin request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "" },
    { "key": "userEmail", "value": "" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "vacationId", "value": "" },
    { "key": "newVacationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('userEmail', `postman-test-${Date.now()}@example.com`);"] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns a token and no password', () => {",
                  "  pm.expect(body.token).to.be.a('string');",
                  "  pm.expect(body.user).to.not.have.property('password');",
                  "  pm.expect(body.user.role).to.eql('user');",
                  "});",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Tester\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"abcd\"\n}"
            },
            "description": "All fields are required, the email must be valid and free, and the password needs at least 4 characters."
          }
        },
        {
          "name": "Register - email taken",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status is 409', () => pm.response.to.have.status(409));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Tester\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"abcd\"\n}"
            }
          }
        },
        {
          "name": "Register - invalid fields",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Tester\",\n  \"email\": \"not-an-email\",\n  \"password\": \"abc\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns a token', () => pm.expect(body.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"abcd\"\n}" }
          }
        },
        {
          "name": "Login - wrong password",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"wrong-password\"\n}" }
          }
        },
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Role is admin', () => pm.expect(body.user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('adminToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "description": "Uses the adminEmail and adminPassword collection variables."
          }
        }
      ]
    },
    {
      "name": "Vacations",
      "item": [
        {
          "name": "Get vacations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('At most 9 per page', () => pm.expect(body.vacations.length).to.be.at.most(9));",
                  "pm.test('Has paging details', () => {",
                  "  pm.expect(body).to.include.keys('page', 'totalPages', 'totalCount');",
                  "});",
                  "pm.test('Sorted by start date', () => {",
                  "  const dates = body.vacations.map((v) => v.start_date);",
                  "  pm.expect(dates).to.eql([...dates].sort());",
                  "});",
                  "pm.collectionVariables.set('vacationId', body.vacations[0].vacation_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/vacations?page=1&filter=all",
              "host": ["{{baseUrl}}"],
              "path": ["vacations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "filter", "value": "all", "description": "all, liked, active or upcoming" }
              ]
            }
          }
        },
        {
          "name": "Get vacations - no token",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/vacations", "host": ["{{baseUrl}}"], "path": ["vacations"] }
          }
        },
        {
          "name": "Get vacation by id",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/vacations/{{vacationId}}", "host": ["{{baseUrl}}"], "path": ["vacations", "{{vacationId}}"] }
          }
        },
        {
          "name": "Like vacation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Marked as liked', () => pm.expect(pm.response.json().is_liked).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/vacations/{{vacationId}}/like", "host": ["{{baseUrl}}"], "path": ["vacations", "{{vacationId}}", "like"] }
          }
        },
        {
          "name": "Get liked vacations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Only the liked vacation', () => pm.expect(pm.response.json().totalCount).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/vacations?page=1&filter=liked",
              "host": ["{{baseUrl}}"],
              "path": ["vacations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "filter", "value": "liked" }
              ]
            }
          }
        },
        {
          "name": "Remove like",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('No longer liked', () => pm.expect(pm.response.json().is_liked).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/vacations/{{vacationId}}/like", "host": ["{{baseUrl}}"], "path": ["vacations", "{{vacationId}}", "like"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Add vacation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('newVacationId', pm.response.json().vacation_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/vacations", "host": ["{{baseUrl}}"], "path": ["vacations"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "destination", "value": "Postman test vacation, Portugal", "type": "text" },
                { "key": "description", "value": "A test vacation created from Postman.", "type": "text" },
                { "key": "start_date", "value": "2030-01-10", "type": "text" },
                { "key": "end_date", "value": "2030-01-15", "type": "text" },
                { "key": "price", "value": "1500", "type": "text" },
                { "key": "image", "type": "file", "src": "images/rome.jpg" }
              ]
            },
            "description": "All fields and the image are required. Price must be between 0 and 10000. Dates cannot be in the past, and the end date cannot be before the start date."
          }
        },
        {
          "name": "Add vacation - invalid price",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/vacations", "host": ["{{baseUrl}}"], "path": ["vacations"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "destination", "value": "Postman test vacation, Portugal", "type": "text" },
                { "key": "description", "value": "A test vacation created from Postman.", "type": "text" },
                { "key": "start_date", "value": "2030-01-10", "type": "text" },
                { "key": "end_date", "value": "2030-01-15", "type": "text" },
                { "key": "price", "value": "10001", "type": "text" },
                { "key": "image", "type": "file", "src": "images/rome.jpg" }
              ]
            }
          }
        },
        {
          "name": "Edit vacation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Saved past dates', () => pm.expect(pm.response.json().start_date).to.eql('2020-01-10'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/vacations/{{newVacationId}}", "host": ["{{baseUrl}}"], "path": ["vacations", "{{newVacationId}}"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "destination", "value": "Postman test vacation, Portugal", "type": "text" },
                { "key": "description", "value": "An edited test vacation.", "type": "text" },
                { "key": "start_date", "value": "2020-01-10", "type": "text" },
                { "key": "end_date", "value": "2020-01-15", "type": "text" },
                { "key": "price", "value": "2000", "type": "text" }
              ]
            },
            "description": "The image is optional here, and past dates are allowed."
          }
        },
        {
          "name": "Like as admin - forbidden",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status is 403', () => pm.response.to.have.status(403));"] }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/vacations/{{vacationId}}/like", "host": ["{{baseUrl}}"], "path": ["vacations", "{{vacationId}}", "like"] }
          }
        },
        {
          "name": "Get likes report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has destination and likes_count', () => {",
                  "  pm.expect(pm.response.json()[0]).to.have.keys('destination', 'likes_count');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/vacations/report", "host": ["{{baseUrl}}"], "path": ["vacations", "report"] }
          }
        },
        {
          "name": "Download likes CSV",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is a CSV file', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));",
                  "pm.test('Has the header row', () => pm.expect(pm.response.text()).to.include('Destination,Likes'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/vacations/report/csv", "host": ["{{baseUrl}}"], "path": ["vacations", "report", "csv"] }
          }
        },
        {
          "name": "Get report as user - forbidden",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status is 403', () => pm.response.to.have.status(403));"] }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/vacations/report", "host": ["{{baseUrl}}"], "path": ["vacations", "report"] }
          }
        },
        {
          "name": "Delete vacation",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/vacations/{{newVacationId}}", "host": ["{{baseUrl}}"], "path": ["vacations", "{{newVacationId}}"] },
            "description": "Deletes the test vacation with its likes and image. Do not point newVacationId at a real vacation."
          }
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Get trip recommendation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns text', () => pm.expect(pm.response.json().recommendation).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/ai/recommendation", "host": ["{{baseUrl}}"], "path": ["ai", "recommendation"] },
            "body": { "mode": "raw", "raw": "{\n  \"destination\": \"Paris\"\n}" },
            "description": "Calls Gemini and uses the API key quota. Returns 502 if Gemini is unavailable."
          }
        }
      ]
    },
    {
      "name": "MCP",
      "item": [
        {
          "name": "Ask a question",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns text', () => pm.expect(pm.response.json().answer).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/mcp/ask", "host": ["{{baseUrl}}"], "path": ["mcp", "ask"] },
            "body": { "mode": "raw", "raw": "{\n  \"question\": \"What is the average price of the vacations?\"\n}" },
            "description": "Calls Gemini, which reads the database through the MCP server. Uses the API key quota and returns 502 if Gemini is unavailable."
          }
        }
      ]
    }
  ]
}
